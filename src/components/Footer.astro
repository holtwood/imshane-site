---
import Container from "@components/Container.astro";
import Link from "@components/Link.astro";
import { SITE } from "@consts";
import BackToTop from "@components/BackToTop.astro";
---

<footer>
  <Container>
    <div class="relative">
      <div class="absolute right-0 -top-20">
        <BackToTop />
      </div>
    </div>
    <div class="space-y-3">
      <div class="flex flex-wrap justify-between items-center gap-2">
        <div>
          &copy; {new Date().getFullYear()} Shane · 简说笔记
        </div>
        <div class="flex flex-wrap gap-1 items-center">
          <Link href="https://github.com/holtwood" external>
            GitHub
          </Link>
          <span aria-hidden="true">·</span>
          <Link href="/rss.xml" external>
            RSS
          </Link>
          {SITE.EMAIL && (
            <>
              <span aria-hidden="true">·</span>
              <Link href={`mailto:${SITE.EMAIL}`}>
                Email
              </Link>
            </>
          )}
        </div>
      </div>
      <div class="text-xs text-black/60 dark:text-white/70">
        <Link href="https://beian.miit.gov.cn" external underline={false}>
          粤ICP备2026121144号
        </Link>
        {/* 公安联网备案号占位：备案通过后在下方追加公网安备链接，未通过前不展示 */}
      </div>
    </div>
  </Container>
</footer>
