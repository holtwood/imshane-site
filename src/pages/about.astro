---
import { getCollection } from "astro:content";
import Container from "@components/Container.astro";
import PageLayout from "@layouts/PageLayout.astro";
import Link from "@components/Link.astro";
import { yearRange } from "@lib/utils";
import { ABOUT, SOCIALS } from "@consts";

const work = await Promise.all(
  (await getCollection("work"))
    .sort((a, b) => b.data.startYear - a.data.startYear)
    .map(async (item) => {
      const { Content } = await item.render();
      return { ...item, Content };
    })
);
---

<PageLayout title={ABOUT.TITLE} description={ABOUT.DESCRIPTION}>
  <Container>
    <div class="space-y-10">
      <div class="animate space-y-2">
        <h1 class="font-semibold text-black dark:text-white text-xl">
          Shane
        </h1>
        <div class="text-sm text-black/60 dark:text-white/70">
          Software Engineer
        </div>
      </div>

      <section class="animate space-y-4">
        <h2 class="font-semibold text-black dark:text-white">
          Introduction
        </h2>
        <article class="space-y-4">
          <p>
            软件工程师。写过医学算法软件，做过实时音视频后台，
            也在 BGI 做过生信相关的高性能计算与平台开发。
            现在主要做 AI Infra / HPC 系统：CUDA 算子、推理运行时与 Serving。
          </p>
          <p>
            这个网站是我的个人主页：技术文章、项目，
            以及一些长期想留下来的记录。
          </p>
        </article>
      </section>

      <section class="animate space-y-4">
        <h2 class="font-semibold text-black dark:text-white">
          Focus
        </h2>
        <ul class="flex flex-col gap-1">
          <li>C++</li>
          <li>AI Infrastructure</li>
          <li>LLM Inference &amp; Serving</li>
          <li>CUDA / Triton Kernels</li>
          <li>Performance Engineering</li>
        </ul>
      </section>

      <section class="animate space-y-4">
        <h2 class="font-semibold text-black dark:text-white">
          Experience
        </h2>
        <ul class="flex flex-col space-y-6">
          {work.map(entry => (
            <li>
              <div class="text-sm text-black/60 dark:text-white/70">
                {yearRange(entry.data.startYear, entry.data.endYear)}
              </div>
              <div class="font-semibold text-black dark:text-white">
                {entry.data.company}
              </div>
              <div class="text-sm text-black/60 dark:text-white/70">
                {entry.data.role}
              </div>
              <article class="mt-2">
                <entry.Content />
              </article>
            </li>
          ))}
        </ul>
      </section>

      <section class="animate space-y-4">
        <h2 class="font-semibold text-black dark:text-white">
          Elsewhere
        </h2>
        <ul class="flex flex-wrap gap-2">
          {SOCIALS.map(s => (
            <li class="flex gap-x-2 text-nowrap">
              <Link href={s.HREF} external aria-label={`Shane on ${s.NAME}`}>
                {s.NAME}
              </Link>
              <span aria-hidden="true">/</span>
            </li>
          ))}
          <li class="text-nowrap">
            <Link href="/rss.xml" external aria-label="RSS feed">
              RSS
            </Link>
          </li>
        </ul>
      </section>
    </div>
  </Container>
</PageLayout>
