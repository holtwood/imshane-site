---
import { getCollection } from "astro:content";
import PageLayout from "@layouts/PageLayout.astro";
import Container from "@components/Container.astro";
import Link from "@components/Link.astro";
import { PROJECTS } from "@consts";

const projects = (await getCollection("projects"))
  .filter(project => !project.data.draft)
  .sort((a, b) => (a.data.order ?? 99) - (b.data.order ?? 99));
---

<PageLayout title={PROJECTS.TITLE} description={PROJECTS.DESCRIPTION}>
  <Container>
    <div class="space-y-10">
      <div class="animate space-y-2">
        <h1 class="font-semibold text-black dark:text-white">
          Projects
        </h1>
        <p class="text-sm text-black/60 dark:text-white/70">
          Things I've built and explored.
        </p>
      </div>
      <ul class="animate flex flex-col gap-6">
        {projects.map((project) => (
          <li class="space-y-1">
            <Link href={`/projects/${project.slug}/`} underline={false}>
              <span class="font-semibold text-black dark:text-white">{project.data.title}</span>
            </Link>
            <p class="text-sm text-black/60 dark:text-white/70">
              {project.data.description}
            </p>
            {project.data.tags.length > 0 && (
              <p class="text-sm text-black/60 dark:text-white/70">
                {project.data.tags.join(" · ")}
              </p>
            )}
          </li>
        ))}
      </ul>
    </div>
  </Container>
</PageLayout>
