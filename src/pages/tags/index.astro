---
import { getCollection } from "astro:content";
import PageLayout from "@layouts/PageLayout.astro";
import Container from "@components/Container.astro";
import Link from "@components/Link.astro";

const posts = (await getCollection("blog")).filter(post => !post.data.draft);

const tagCount = new Map<string, number>();
for (const post of posts)
  for (const tag of post.data.tags ?? [])
    tagCount.set(tag, (tagCount.get(tag) ?? 0) + 1);

const tags = [...tagCount.entries()].sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0]));
---

<PageLayout title="Tags" description="按标签浏览文章。">
  <Container>
    <div class="space-y-10">
      <div class="animate space-y-2">
        <div class="font-semibold text-black dark:text-white">
          Tags
        </div>
        <p class="text-sm opacity-75">
          按标签浏览文章。
        </p>
      </div>
      <ul class="animate flex flex-col gap-3">
        {tags.map(([tag, count]) => (
          <li class="flex items-baseline gap-4">
            <Link href={`/tags/${tag}/`} underline={false}>{tag}</Link>
            <span class="text-sm opacity-50">{count}</span>
          </li>
        ))}
      </ul>
    </div>
  </Container>
</PageLayout>
