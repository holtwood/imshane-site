---
import { type CollectionEntry, getCollection } from "astro:content";
import PageLayout from "@layouts/PageLayout.astro";
import Container from "@components/Container.astro";
import FormattedDate from "@components/FormattedDate.astro";
import { readingTime } from "@lib/utils";
import BackToPrev from "@components/BackToPrev.astro";

export async function getStaticPaths() {
  const posts = (await getCollection("blog"))
    .filter(post => !post.data.draft)
    .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: post,
  }));
}
type Props = CollectionEntry<"blog">;

const post = Astro.props;
const { Content } = await post.render();
const { title, date, updatedDate, tags, categories } = post.data;
---

<PageLayout title={title} description={post.data.description}>
  <Container>
    <div class="animate">
      <BackToPrev href="/blog">
        Back to blog
      </BackToPrev>
    </div>
    <div class="space-y-1 my-10">
      <div class="animate flex flex-wrap items-center gap-x-1.5 text-sm">
        <FormattedDate date={date} />
        &bull;
        <div>
          {readingTime(post.body)}
        </div>
        {updatedDate && (
          <>
            &bull;
            <div class="opacity-75">
              更新于 <FormattedDate date={updatedDate} />
            </div>
          </>
        )}
      </div>
      <div class="animate text-2xl font-semibold text-black dark:text-white">
        {title}
      </div>
      {(categories.length > 0 || tags.length > 0) && (
        <div class="animate flex flex-wrap gap-x-4 text-sm opacity-60">
          {categories.length > 0 && (
            <span>分类：{categories.join(" · ")}</span>
          )}
          {tags.length > 0 && (
            <span>标签：{tags.join(" · ")}</span>
          )}
        </div>
      )}
    </div>
    <article class="animate">
      <Content />
    </article>
  </Container>
</PageLayout>
